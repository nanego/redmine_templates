<%= render 'issues/sections/separator_form' %>
<div class="subtitle_container">

  <% if section.title.present? %>
    <div class="subtitle">
      <%= section.title %>
    </div>
  <% end %>

  <% if section.retracted && group_index == '0' %>
    <%= link_to sprite_icon('add'), '#', class: "expand_button expander icon", data: {group_id: section.id} %>
    <%= link_to sprite_icon('cancel'), '#', class: "expand_button retracter icon", data: {group_id: section.id} %>
  <% end %>

</div>
